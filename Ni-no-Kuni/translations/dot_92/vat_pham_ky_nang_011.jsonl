{"id": "VAT_1fff68feea9946", "translation": "Kem có hương vị dịu nhẹ."}
{"id": "VAT_e0608c887ff80b", "translation": "Chứa đầy lợi khuẩn\ngiúp cơ thể khỏe mạnh hơn.\nĂn mỗi ngày càng tốt!"}
{"id": "VAT_121500d83fb1cd", "translation": "Một loại quả có\nchiếc lá khổng lồ mọc trên đầu."}
{"id": "VAT_a6e86acaebdb90", "translation": "Quả đỏ tươi thơm ngọt,\nrất hợp với các món tráng miệng."}
{"id": "VAT_9637fa14a5b7ac", "translation": "Quả mọng nước, thanh mát\nvới vị ngọt pha chút đắng."}
{"id": "VAT_141f02c8ed27e5", "translation": "Kẹo caramen mềm, ngọt vừa,\ntan ngay trong miệng."}
{"id": "VAT_38edddb2cd1e7c", "translation": "Sốt caramen ngọt ngào\nhòa quyện cùng kem trứng béo ngậy."}
{"id": "VAT_c1f81d11973cab", "translation": "Sô-cô-la ngọt thơm,\nđắt khách đến mức thường cháy hàng."}
{"id": "VAT_fb9a68db1ad5c2", "translation": "Sầu riêng lạ miệng, ngon tuyệt\nnhưng mùi thì nồng đến tận trời!"}
{"id": "VAT_718ec90d63838d", "translation": "Món ngọt thanh mát,\năn vào thấy sảng khoái."}
{"id": "VAT_2e969bd8e21194", "translation": "Bánh sô-cô-la thủ công\nvừa ngọt vừa đăng đắng."}
{"id": "VAT_fcff396938f731", "translation": "Ly kem phủ sốt sô-cô-la,\nthêm đầy ắp trái cây."}
{"id": "VAT_63e9a66afa6342", "translation": "Caramen sữa đánh với kem tươi,\nbéo mịn và tan ngay trên đầu lưỡi."}
{"id": "VAT_088c4f58d49e79", "translation": "Chuối bổ đôi phủ đầy\nnhững viên kem mát lạnh."}
{"id": "VAT_3131fd9ad9535b", "translation": "Chuối nhúng trong\nsô-cô-la ngọt lịm."}
{"id": "VAT_81984c2d631e8b", "translation": "Bánh kem trứng giàu dinh dưỡng,\nlàm từ rất nhiều trứng."}
{"id": "VAT_229d600130fb53", "translation": "Kẹo bông gòn khổng lồ,\nbồng bềnh như một đám mây."}
{"id": "VAT_5f52a31e2fb6d1", "translation": "Vị quả mọng thoang thoảng\nkhiến bạn phải chu môi thích thú."}
{"id": "VAT_0617d2b8635fc6", "translation": "Bánh kem quả mọng đơn giản\nmà ngon tuyệt."}
{"id": "VAT_71c4a7cc536ef0", "translation": "Kẹo caramen dịu ngọt\nbọc trong lớp sô-cô-la béo ngậy."}
{"id": "VAT_c72217009093fb", "translation": "Bánh pudding phủ sốt caramen,\nngọt thanh và đậm vị,\nhợp cả khẩu vị người lớn."}
{"id": "VAT_5e47ab6564b91a", "translation": "Bánh kẹp đầy những lát trái cây\nvà một lớp kem tươi thật dày."}
{"id": "VAT_6bd379c7906fb1", "translation": "Món Boniato phủ sốt caramen,\nđặc biệt được trẻ con yêu thích."}
{"id": "VAT_2ba707acdb0a4f", "translation": "Kem Bavaria hương quả mọng,\nngọt dịu và mềm mịn."}
{"id": "VAT_f23fc91c469d5f", "translation": "Loại kem béo mịn, đậm đà,\nđược bao người yêu thích."}
{"id": "VAT_fe7d83e756351b", "translation": "Kem ít calo,\nđọng lại vị sô-cô-la ngọt ngào."}
{"id": "VAT_114891aa21dd09", "translation": "Kem trộn đầy\nnhững quả mọng nguyên trái."}
{"id": "VAT_34ea5be5606279", "translation": "Kem chua chua ngọt ngọt,\nthoảng hương nho."}
{"id": "VAT_3f944043196e86", "translation": "Nước nho ép chậm,\nlàm thủ công đầy chăm chút."}
{"id": "VAT_8241ebb9eee53d", "translation": "Bánh vòng mềm\nnhồi đầy nho khô."}
{"id": "VAT_1c18f96d0a6d6b", "translation": "Si-rô ngâm từ\ntrái cây vừa hái."}
{"id": "VAT_b33530e8302a5d", "translation": "Chia chiếc bánh khổng lồ này\nvới Imagen bạn yêu quý nhất nhé!"}
{"id": "VAT_70f34cabce928f", "translation": "Đón năm mới cùng Imagen\nvới bánh mochi ngày Tết!"}
{"id": "VAT_19e0ef0a8c227a", "translation": "Tặng sô-cô-la tự làm\ncho Imagen bạn yêu quý nhất\nđể gửi gắm tình thương."}
{"id": "VAT_59c0235e0a8c03", "translation": "Mochi hồng nhân đậu đỏ ngọt,\ngói trong chiếc lá xinh xắn."}
{"id": "VAT_3275d6941208dd", "translation": "Đã trang trí búp bê Hinamatsuri chưa?\nMừng lễ hội búp bê\nbằng bánh gạo giòn nhé!"}
